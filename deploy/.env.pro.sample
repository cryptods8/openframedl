# Environment configuration for pro.framedl.xyz (Framedl PRO)
NODE_ENV=production
PORT=3000

# Base URLs
NEXT_PUBLIC_HOST=https://pro.framedl.xyz
BASE_URL=https://pro.framedl.xyz
EXTERNAL_BASE_URL=https://pro.framedl.xyz
NEXT_PUBLIC_DOMAIN=pro.framedl.xyz
NEXTAUTH_URL=https://pro.framedl.xyz

# Neon PostgreSQL Database (PRO database)
PG_CONNECTION_STRING=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/framedl_pro?sslmode=require

# App Secrets & Auth
NEXTAUTH_SECRET=
JWT_SECRET=
SIGNING_KEY=
SEED_SALT=
ADMIN_SECRET=
SHUFFLE_SECRET=
CRON_SECRET=

# Framedl PRO Flag (MUST be true for pro)
FRAMEDL_PRO=true

# Neynar & Farcaster
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
NEYNAR_BOT_WEBHOOK_SECRET=
WARPCAST_DC_API_KEY=

# Badges & Web3
NEXT_PUBLIC_BADGE_NFT_CA=
NEXT_PUBLIC_BADGE_NFT_CHAIN_ID=
BADGE_NFT_SIGNER_PK=

# Redis (if used)
REDIS_API_URL=
REDIS_API_TOKEN=

# Image generation
OPTIMIZE_IMAGES=true

# Environment configuration for framedl.com (Regular daily framedl)
NODE_ENV=production
PORT=3000

# Base URLs
NEXT_PUBLIC_HOST=https://framedl.com
BASE_URL=https://framedl.com
EXTERNAL_BASE_URL=https://framedl.com
NEXT_PUBLIC_DOMAIN=framedl.com
NEXTAUTH_URL=https://framedl.com

# Neon PostgreSQL Database
PG_CONNECTION_STRING=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/framedl?sslmode=require

# App Secrets & Auth
NEXTAUTH_SECRET=
JWT_SECRET=
SIGNING_KEY=
SEED_SALT=
ADMIN_SECRET=
SHUFFLE_SECRET=
CRON_SECRET=

# Framedl PRO Flag (false for regular framedl)
FRAMEDL_PRO=false

# Neynar & Farcaster
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
NEYNAR_BOT_WEBHOOK_SECRET=
WARPCAST_DC_API_KEY=

# Badges & Web3
NEXT_PUBLIC_BADGE_NFT_CA=
NEXT_PUBLIC_BADGE_NFT_CHAIN_ID=
BADGE_NFT_SIGNER_PK=

# Redis (if used)
REDIS_API_URL=
REDIS_API_TOKEN=

# Image generation
OPTIMIZE_IMAGES=true
